@@ -0,0 +1,125 @@
+use ratatui::style::{Color, Modifier};
+
+use super::tokyonight::Theme;
+
+const fn rgb(r: u8, g: u8, b: u8) -> Color {
+    Color::Rgb(r, g, b)
+}
+
+/// Vesper palette — ported from Herdr's built-in theme
+/// (`ogulcancelik/herdr` `Palette::vesper`).
+///
+/// Minimal high-contrast monochrome base with peach and mint accents.
+#[allow(dead_code)]
+mod palette {
+    use super::*;
+
+    // -- backgrounds (near-black monochrome ramp) -----------------------------
+    pub const BASE: Color = rgb(16, 16, 16); // #101010  editor.background
+    pub const SURFACE: Color = rgb(16, 16, 16); // #101010  surface_dim
+    pub const ELEVATED: Color = rgb(40, 40, 40); // #282828  surface1
+    pub const HIGHLIGHT: Color = rgb(35, 35, 35); // #232323  surface0
+
+    // -- text -----------------------------------------------------------------
+    pub const TEXT: Color = rgb(255, 255, 255); // #FFFFFF
+    pub const SUBTEXT: Color = rgb(160, 160, 160); // #A0A0A0
+
+    // -- muted / overlays -----------------------------------------------------
+    pub const MUTED: Color = rgb(80, 80, 80); // #505050  editorLineNumber
+    pub const SUBTLE: Color = rgb(139, 139, 139); // #8B8B8B  comments
+
+    // -- accents (peach + mint) -----------------------------------------------
+    pub const PEACH: Color = rgb(255, 199, 153); // #FFC799  accent / yellow / peach
+    pub const PEACH_BRIGHT: Color = rgb(255, 209, 168); // #FFD1A8  mauve
+    pub const MINT: Color = rgb(153, 255, 228); // #99FFE4  green
+    pub const TEAL: Color = rgb(153, 255, 228); // #99FFE4  (Vesper has no teal)
+    pub const RED: Color = rgb(255, 128, 128); // #FF8080
+    pub const GRAY_BLUE: Color = rgb(160, 160, 160); // #A0A0A0  (no blue in Vesper)
+}
+use palette::*;
+
+impl Theme {
+    pub const fn vesper() -> Self {
+        Self {
+            bg_base: BASE,
+            bg_light: ELEVATED,
+            bg_dark: SURFACE,
+            bg_highlight: HIGHLIGHT,
+            bg_hover: ELEVATED,
+            bg_terminal: BASE,
+
+            accent_user: PEACH,
+            accent_assistant: MINT,
+            accent_thinking: MUTED,
+            accent_tool: SUBTLE,
+            accent_system: GRAY_BLUE,
+            accent_error: RED,
+            accent_success: MINT,
+            accent_running: TEAL,
+            accent_skill: PEACH_BRIGHT,
+
+            text_primary: TEXT,
+            text_secondary: SUBTEXT,
+
+            gray_dim: MUTED,
+            gray: SUBTLE,
+            gray_bright: SUBTEXT,
+
+            command: PEACH,
+            path: PEACH_BRIGHT,
+            running: TEAL,
+            warning: PEACH,
+
+            fuzzy_accent: PEACH,
+
+            accent_plan: PEACH,
+
+            accent_verify: TEAL,
+
+            accent_remember: MINT,
+
+            selection_border: ELEVATED,
+            hover_border: HIGHLIGHT,
+            prompt_border: HIGHLIGHT,
+            prompt_border_active: PEACH,
+
+            accent_model: GRAY_BLUE,
+
+            scrollbar_bg: SURFACE,
+            scrollbar_fg: rgb(52, 52, 52),
+
+            diff_delete_bg: rgb(36, 25, 25),
+            diff_delete_fg: RED,
+            diff_insert_bg: rgb(27, 36, 33),
+            diff_insert_fg: MINT,
+            diff_equal_fg: MUTED,
+            diff_gutter_fg: MUTED,
+
+            bg_visual: rgb(51, 51, 51),
+
+            paste_bg: HIGHLIGHT,
+            paste_fg: SUBTEXT,
+            paste_dim: MUTED,
+
+            md_heading_h1: TEXT,
+            md_heading_h1_mod: Modifier::BOLD,
+            md_heading_h2: PEACH,
+            md_heading_h2_mod: Modifier::BOLD,
+            md_heading_h3: MINT,
+            md_heading_h3_mod: Modifier::BOLD,
+            md_heading_h4: TEAL,
+            md_heading_h4_mod: Modifier::BOLD.union(Modifier::ITALIC),
+            md_heading_h5: PEACH_BRIGHT,
+            md_heading_h5_mod: Modifier::BOLD,
+            md_heading_h6: GRAY_BLUE,
+            md_heading_h6_mod: Modifier::BOLD,
+            md_code: TEAL,
+            md_task_checked: MINT,
+            md_task_unchecked: SUBTEXT,
+            md_muted: MUTED,
+            md_code_bg: HIGHLIGHT,
+            md_text: TEXT,
+            link_fg: PEACH,
+        }
+    }
+}
