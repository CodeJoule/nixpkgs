+//! `/transparency` -- toggle transparent theme backgrounds.
+//!
+//! When on, theme canvas backgrounds (`bg_*`) paint as `Color::Reset` so the
+//! host terminal (Ghostty opacity/blur, etc.) shows through while accents and
+//! text keep the selected theme's colors.
+//!
+//! Dispatches `Action::ToggleTransparentBg` so the slash command shares the
+//! same gate as the settings modal toggle.
+
+use crate::app::actions::Action;
+use crate::slash::command::{CommandExecCtx, CommandResult, SlashCommand};
+
+/// Toggle transparent background mode via `/transparency`.
+pub struct TransparencyCommand;
+
+impl SlashCommand for TransparencyCommand {
+    fn name(&self) -> &str {
+        "transparency"
+    }
+
+    fn description(&self) -> &str {
+        "Toggle transparent UI backgrounds (show terminal opacity/blur)"
+    }
+
+    fn usage(&self) -> &str {
+        "/transparency"
+    }
+
+    fn run(&self, _ctx: &mut CommandExecCtx, _args: &str) -> CommandResult {
+        CommandResult::Action(Action::ToggleTransparentBg)
+    }
+}
