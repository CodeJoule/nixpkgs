+}
+
+/// Set transparent background mode. Idempotent: skips if `new == prev`.
+pub(in crate::app::dispatch) fn set_transparent_bg(app: &mut AppView, new: bool) -> Vec<Effect> {
+    let prev = app.current_ui.transparent_bg;
+    if prev == new {
+        return vec![];
+    }
+    set_transparent_bg_inner(app, new);
+    refresh_open_settings_modals(app);
+    tracing::info!(target: "settings", key = "transparent_bg", value = new, "setting changed");
+    app.show_toast(&save_success_toast("Transparent background", new));
+    vec![Effect::PersistSetting {
+        key: "transparent_bg",
+        value: crate::settings::SettingValue::Bool(new),
+        rollback_value: crate::settings::SettingValue::Bool(prev),
+    }]
+}
