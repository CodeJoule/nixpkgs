+/// How long a bare Space must be held before it becomes push-to-talk.
+/// A quicker tap still types a space / focuses the prompt.
+const SPACE_HOLD_THRESHOLD: Duration = Duration::from_millis(200);
+
+fn is_bare_space_key(ke: &KeyEvent) -> bool {
+    ke.code == KeyCode::Char(' ') && ke.modifiers.is_empty()
+}
+
+/// True when the batch ends on a bare Space press that has not yet seen
+/// a matching Release, Repeat, or follow-up key — we should wait.
+fn space_press_unresolved(events: &[TimedInputEvent]) -> bool {
+    let mut pending = false;
+    for ev in events {
+        match &ev.event {
+            Event::Key(ke) if is_bare_space_key(ke) => match ke.kind {
+                KeyEventKind::Press => pending = true,
+                KeyEventKind::Release | KeyEventKind::Repeat => pending = false,
+                _ => {}
+            },
+            // Space then another key is a tap ("hello world"), not a hold.
+            Event::Key(ke) if ke.kind == KeyEventKind::Press => pending = false,
+            Event::Paste(_) => pending = false,
+            _ => {}
+        }
+    }
+    pending
+}
+
+/// True when a bare Space press in this batch is a hold (Repeat arrived,
+/// or the press is still down after the wait window) rather than a tap.
+fn space_hold_indicated<'a>(events: impl IntoIterator<Item = &'a Event>) -> bool {
+    let mut pending = false;
+    for ev in events {
+        match ev {
+            Event::Key(ke) if is_bare_space_key(ke) => match ke.kind {
+                KeyEventKind::Press => pending = true,
+                KeyEventKind::Repeat if pending => return true,
+                KeyEventKind::Release => pending = false,
+                _ => {}
+            },
+            Event::Key(ke) if ke.kind == KeyEventKind::Press => pending = false,
+            Event::Paste(_) => pending = false,
+            _ => {}
+        }
+    }
+    pending
+}
+
+/// Hold-Space PTT mapping. A tap (`hold_this_batch == false`) never starts
+/// voice — that press falls through and types a space.
+fn space_hold_action(
+    kind: KeyEventKind,
+    hold_this_batch: bool,
+    listening: bool,
+    hold_owned: bool,
+) -> Option<crate::app::actions::Action> {
+    use crate::app::actions::Action;
+    match kind {
+        KeyEventKind::Press if hold_this_batch && !listening => Some(Action::EnableVoiceMode),
+        KeyEventKind::Press if hold_this_batch && listening && !hold_owned => {
+            Some(Action::VoiceToggle)
+        }
+        KeyEventKind::Release if hold_owned => Some(Action::VoiceStop),
+        _ => None,
+    }
+}
+
+/// Whether the hold-Space intercept claims this event.
+///
+/// A tap Space press is never claimed (it must type). An active hold
+/// owns its events end-to-end so a setting flip cannot wedge the mic.
+fn space_hold_claims_event(
+    kind: KeyEventKind,
+    hold_this_batch: bool,
+    keybind_enabled: bool,
+    hold_owned: bool,
+) -> bool {
+    if hold_owned {
+        return true;
+    }
+    keybind_enabled && hold_this_batch && kind != KeyEventKind::Release
+}
