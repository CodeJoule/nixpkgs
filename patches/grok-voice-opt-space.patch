+/// How long a bare Space must be held before it becomes push-to-talk.
+/// A quicker tap still types a space / focuses the prompt. Longer than a
+/// typical tap, long enough to see Kitty Repeat on a real hold.
+const SPACE_HOLD_THRESHOLD: Duration = Duration::from_millis(400);
+
+/// Set when a Space press timed out with no Release or Repeat: this session
+/// does not actually report printable-key event types, even if we pushed
+/// `REPORT_ALL_KEYS_AS_ESCAPE_CODES`. Hold-Space stays off for the rest of
+/// the process so later taps are not delayed.
+static SPACE_EVENT_TYPES_UNRELIABLE: AtomicBool = AtomicBool::new(false);
+
+fn is_bare_space_key(ke: &KeyEvent) -> bool {
+    ke.code == KeyCode::Char(' ') && ke.modifiers.is_empty()
+}
+
+/// Whether hold-Space PTT can distinguish a tap from a hold in this session.
+///
+/// `kitty_all_keys_reported` only means we *pushed* the all-keys bit. herdr's
+/// VT still delivers a bare Space as UTF-8 with no release (herdr#1746), and
+/// a timeout-as-hold would open the mic on every typed space. Skip the
+/// intercept there; F8 still works. A live timeout without Repeat/Release
+/// latches the same skip for any other VT that lies the same way.
+fn space_hold_protocol_live() -> bool {
+    if SPACE_EVENT_TYPES_UNRELIABLE.load(Ordering::Relaxed) {
+        return false;
+    }
+    if !crate::app::kitty_all_keys_reported() {
+        return false;
+    }
+    crate::terminal::terminal_context().multiplexer != crate::terminal::MultiplexerKind::Herdr
+}
+
+/// True when the batch ends on a bare Space press that has not yet seen
+/// a matching Release, Repeat, or follow-up key — we should wait.
+fn space_press_unresolved(events: &[TimedInputEvent]) -> bool {
+    let mut pending = false;
+    for ev in events {
+        match &ev.event {
+            Event::Key(ke) if is_bare_space_key(ke) => match ke.kind {
+                KeyEventKind::Press => pending = true,
+                KeyEventKind::Release | KeyEventKind::Repeat => pending = false,
+                _ => {}
+            },
+            // Space then another key is a tap ("hello world"), not a hold.
+            Event::Key(ke) if ke.kind == KeyEventKind::Press => pending = false,
+            Event::Paste(_) => pending = false,
+            _ => {}
+        }
+    }
+    pending
+}
+
+/// True when a bare Space press in this batch is a hold (a Repeat arrived
+/// while the key was still down) rather than a tap.
+///
+/// A trailing unresolved Press is **not** a hold. Multiplexers such as herdr
+/// never send a Space release, so "no Release after the wait window" is also
+/// the shape of a normal tap. Only an explicit Repeat proves the key is held.
+/// Callers still gate on [`space_hold_protocol_live`] so a session that cannot
+/// produce Repeat never intercepts Space.
+fn space_hold_indicated<'a>(events: impl IntoIterator<Item = &'a Event>) -> bool {
+    let mut pending = false;
+    for ev in events {
+        match ev {
+            Event::Key(ke) if is_bare_space_key(ke) => match ke.kind {
+                KeyEventKind::Press => pending = true,
+                KeyEventKind::Repeat if pending => return true,
+                KeyEventKind::Release => pending = false,
+                _ => {}
+            },
+            Event::Key(ke) if ke.kind == KeyEventKind::Press => pending = false,
+            Event::Paste(_) => pending = false,
+            _ => {}
+        }
+    }
+    let _ = pending;
+    false
+}
+
+/// Hold-Space PTT mapping. A tap (`hold_this_batch == false`) never starts
+/// voice — that press falls through and types a space.
+fn space_hold_action(
+    kind: KeyEventKind,
+    hold_this_batch: bool,
+    listening: bool,
+    hold_owned: bool,
+) -> Option<crate::app::actions::Action> {
